# Supabase Postgres connection string — pooled (pgBouncer), used by the app at runtime.
# Get it from Supabase > Connect > Shared pooler. Append ?pgbouncer=true.
DATABASE_URL="postgresql://johndoe:randompassword@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection — used only by `prisma migrate`. From Supabase > Connect > Direct connection.
DIRECT_URL="postgresql://johndoe:randompassword@db.xxxxxxxx.supabase.co:5432/postgres"

PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4000"

# Google OAuth (Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identity-only login (openid email profile)
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
# Gmail inbox connect (adds gmail.readonly, offline access) — separate flow
GOOGLE_GMAIL_CALLBACK_URL="http://localhost:3000/connections/google/callback"

# JWT session signing
JWT_SECRET=

# Encrypts refresh_token before it touches Postgres (AES-256-GCM, 32-byte hex key)
ENCRYPTION_KEY=

# Gemini API (Google AI Studio)
GEMINI_API_KEY=

# SendGrid (magic-link / transactional email) — free tier: 100/day
# MAIL_FROM must be a Single Sender you verified in SendGrid (Settings > Sender Authentication),
# not a domain — e.g. "Nutian <you@gmail.com>"
SENDGRID_API_KEY=
MAIL_FROM=

# Sync pipeline (runs inline within POST /sync/:id's request, capped by
# vercel.json's maxDuration — one tap loops through extraction batches
# until done or SYNC_SOFT_BUDGET_MS is hit, whichever comes first)
# Max candidate messages discovered (headers-only, cheap) per sync run (default 200 if unset)
SYNC_DISCOVERY_LIMIT=200
# Candidates extracted per batch before re-checking the time budget (default 15 if unset)
SYNC_EXTRACTION_BATCH_SIZE=15
# Concurrent Gmail/Gemini calls in flight at once (default 5 if unset)
SYNC_FETCH_CONCURRENCY=5
# Stop starting new extraction batches once this many ms have elapsed, leaving
# headroom below maxDuration's hard (no-warning) kill (default 50000 if unset)
SYNC_SOFT_BUDGET_MS=50000
